# Local development (`npm run dev`): copy to .env.local

# Laravel API (towork-backend). Server-side only: never exposed to the browser.
API_URL=http://localhost:8000/api/v1

# Force the Secure flag on the auth cookie (it is set automatically on HTTPS requests).
COOKIE_SECURE=false

# Docker Compose overrides (optional)
# TOWORK_NEXT_PORT=3001
# TOWORK_API_URL=http://host.docker.internal:8000/api/v1
# TOWORK_COOKIE_SECURE=false
